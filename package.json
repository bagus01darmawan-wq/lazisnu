{
  "type": "module",
  "name": "lazisnu-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev:backend": "pnpm --filter lazisnu-backend dev",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm start:mobile",
    "run:mobile": "pnpm android:mobile",
    "start:mobile": "pnpm --filter lazisnu-collector-app start",
    "android:mobile": "pnpm --filter lazisnu-collector-app android",
    "build:backend": "pnpm --filter lazisnu-backend build",
    "build:web": "pnpm --filter web build",
    "build:shared": "pnpm --filter @lazisnu/shared-types build",
    "build:all": "pnpm build:shared && pnpm build:backend && pnpm build:web"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "react-day-picker": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "ts-morph": "^28.0.0"
  }
}
