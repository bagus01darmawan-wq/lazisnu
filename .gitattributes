# Line ending enforcement
# Shell scripts & files yang dijalankan di Linux/VM WAJIB LF.
# Mencegah bug CRLF ("syntax error near $'{\r'") saat checkout di VM
# (VM core.autocrlf=true akan konversi ke CRLF tanpa ini).
*.sh text eol=lf
*.bash text eol=lf
*.conf.example text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.env text eol=lf
*.env.example text eol=lf
