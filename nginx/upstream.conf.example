# Template awal — copy ke nginx/upstream.conf saat setup VM pertama kali:
#   cp nginx/upstream.conf.example nginx/upstream.conf
# Setelah itu file dikelola oleh scripts/deploy-blue-green.sh saat switch blue/green.
# Default aman: arahkan ke service docker-compose.yml utama (backend/web).
upstream backend_active {
    server backend:3001;
}
upstream web_active {
    server web:3000;
}
