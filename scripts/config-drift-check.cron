# Config drift check — konsistensi secret JWT antar pasangan web/backend (blue + staging).
# Tiap jam; runtime < 1 menit. Webhook dibaca dari .env.alertmanager / fallback backup webhook.
37 * * * * root /usr/bin/flock -n /run/lock/lazisnu-config-drift.lock /usr/bin/timeout --foreground 5m bash /opt/lazisnu/scripts/config-drift-check.sh
