# Verify the latest R2 backup independently from the daily backup job.
# Dipanggil via `bash script` agar kebal terhadap exec-bit (insiden 2026-08-04:
# git checkout di VM menghilangkan +x → timeout gagal exec script secara senyap).
17 * * * * root /usr/bin/flock -n /run/lock/lazisnu-backup-health.lock /usr/bin/timeout --foreground 5m bash /opt/lazisnu/scripts/backup-healthcheck.sh

# Healthcheck staging backup (marker terpisah backup-status-staging/; log & alert
# state terpisah di backups-staging/; alert Discord channel yang sama).
18 * * * * root /usr/bin/flock -n /run/lock/lazisnu-backup-health-staging.lock /usr/bin/timeout --foreground 5m bash -c 'BACKUP_ENV_FILE=/opt/lazisnu/secrets/env.backup-staging bash /opt/lazisnu/scripts/backup-healthcheck.sh'

# Healthcheck backup produksi khusus (folder/prefix/marker terpisah dari backup
# produksi default di backups/). WAJIB memakai kutipan pada bash -c: tanpa itu,
# cron hanya menjalankan assignment variabel dan skrip tidak pernah dieksekusi.
19 * * * * root /usr/bin/flock -n /run/lock/lazisnu-backup-health-prod.lock /usr/bin/timeout --foreground 5m bash -c 'BACKUP_ENV_FILE=/opt/lazisnu/.env.backup-prod R2_STATUS_KEY=backup-status/lazisnu-prod-latest.json BACKUP_R2_PREFIX=backups-prod BACKUP_DIR=/opt/lazisnu/backups-prod bash /opt/lazisnu/scripts/backup-healthcheck.sh'
