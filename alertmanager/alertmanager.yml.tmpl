# Alertmanager configuration — Lazisnu
# Template: placeholder __DISCORD_WEBHOOK__ diganti nilai env
# DISCORD_WEBHOOK_PROMETHEUS oleh sed di entrypoint container
# (Alertmanager v0.33 tidak me-substitusi ${VAR} di config file).
# Webhook URL TIDAK di-commit — disimpan di /opt/lazisnu/.env.alertmanager (chmod 600).

global:
  resolve_timeout: 5m

route:
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'discord'

receivers:
  - name: 'discord'
    discord_configs:
      - webhook_url: '__DISCORD_WEBHOOK__'
        # Template custom (bukan default bawaan) — default menyertakan link
        # generator Prometheus (http://<container-id>:9090) yang tidak bisa
        # diakses publik. Diganti link dashboard Grafana.
        title: '{{ if eq .Status "firing" }}[FIRING]{{ else }}[RESOLVED]{{ end }} {{ (index .Alerts 0).Labels.alertname }}'
        message: |
          Alerts {{ .Status }}:
          {{ range .Alerts }}
          Labels:
          alertname = {{ .Labels.alertname }}
          instance = {{ .Labels.instance }}
          job = {{ .Labels.job }}
          severity = {{ .Labels.severity }}
          Annotations:
          description = {{ .Annotations.description }}
          summary = {{ .Annotations.summary }}

          Dashboard: https://grafana.lazisnu.site/d/5e2062b3-7e43-456d-9b74-59a3a021fcda/lazisnu-overview
          {{ end }}
