{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["jest", "node"]
  },
  "include": [
    "src/**/*",
    "index.js",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "__tests__/**/*.d.ts",
    "__mocks__/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
